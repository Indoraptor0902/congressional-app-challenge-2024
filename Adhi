    "numpy", "tqdm", "matplotlib", "scikit-learn", "transformers",
    "huggingface_hub", "accelerate", "torch", "torchvision", "torchaudio"
]
cluster_editing_packages = [
    "peft", "ragas", "umap-learn", "plotly", "datasets"
]
install_dependencies(base_packages + cluster_editing_packages)
check_cuda()

